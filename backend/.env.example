# Database (individual vars)
POSTGRES_DB=audioextract
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432

# Or use a single DATABASE_URL (Neon) instead of the individual vars above
# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Django
SECRET_KEY=change_this_to_a_random_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# Get your API key from https://www.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Get your B2 credentials from https://secure.backblazeb2.com
B2_KEY_ID=your_b2_key_id_here
B2_APP_KEY=your_b2_app_key_here
B2_BUCKET=your_b2_bucket_name_here
